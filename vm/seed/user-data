#cloud-config
hostname: xsens-vm
users:
  - name: xsens
    groups: [sudo, dialout, plugdev]
    sudo: "ALL=(ALL) NOPASSWD:ALL"
    shell: /bin/bash
    lock_passwd: false
ssh_pwauth: true
chpasswd:
  expire: false
  list: |
    xsens:xsens
write_files:
  - path: /etc/udev/rules.d/99-xsens.rules
    content: |
      # Awinda dongle / station: let the ftdi_sio driver bind and give the
      # xsens user access without sudo.
      SUBSYSTEM=="usb", ATTRS{idVendor}=="2639", MODE="0666", GROUP="dialout"
      SUBSYSTEM=="tty", ATTRS{idVendor}=="2639", MODE="0666", GROUP="dialout"
runcmd:
  - [ udevadm, control, --reload-rules ]
  - [ udevadm, trigger ]
